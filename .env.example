# =============================================
# JSDB - JavaScript Database Runtime
# Environment Configuration
# =============================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# -----------------------------------------
# DATABASE SELECTION
# Options: mysql | mongodb | postgres | sqlite
# -----------------------------------------
JSDB_DATABASE=mysql

# -----------------------------------------
# MySQL Configuration
# -----------------------------------------
JSDB_HOST=localhost
JSDB_PORT=3306
JSDB_DATABASE_NAME=myapp
JSDB_USER=root
JSDB_PASSWORD=

# Connection Pool
JSDB_POOL_MIN=2
JSDB_POOL_MAX=10
JSDB_POOL_IDLE_TIMEOUT=60000
JSDB_CONNECT_TIMEOUT=10000

# -----------------------------------------
# MongoDB Configuration
# -----------------------------------------
JSDB_MONGO_URI=mongodb://localhost:27017
# JSDB_DATABASE_NAME=myapp  (shared with above)
JSDB_MONGO_MAX_POOL=10

# -----------------------------------------
# PostgreSQL Configuration
# -----------------------------------------
# JSDB_DATABASE_URL=postgresql://user:password@localhost:5432/myapp
# OR individual fields:
# JSDB_HOST=localhost
# JSDB_PORT=5432
# JSDB_DATABASE_NAME=myapp
# JSDB_USER=postgres
# JSDB_PASSWORD=

# -----------------------------------------
# SQLite Configuration
# -----------------------------------------
JSDB_SQLITE_PATH=./data.db

# -----------------------------------------
# Cache Configuration
# Options: none | memory | redis
# -----------------------------------------
JSDB_CACHE=memory
JSDB_CACHE_TTL=300
# JSDB_REDIS_URL=redis://localhost:6379

# -----------------------------------------
# Logging
# Options: silent | error | warn | info | debug
# -----------------------------------------
JSDB_LOG_LEVEL=info

# -----------------------------------------
# Multi-Tenancy
# -----------------------------------------
JSDB_TENANCY=false
JSDB_TENANT_FIELD=tenantId

# -----------------------------------------
# API Runtime
# -----------------------------------------
JSDB_API_ENABLED=false
JSDB_API_PORT=4000
JSDB_API_RATE_LIMIT=100

# -----------------------------------------
# Security
# -----------------------------------------
JSDB_AUDIT_LOG=false

# -----------------------------------------
# Performance
# -----------------------------------------
JSDB_SLOW_QUERY_THRESHOLD=1000
JSDB_QUERY_TIMEOUT=30000

# -----------------------------------------
# Development Mode
# Enables N+1 detection, verbose logging
# -----------------------------------------
JSDB_DEV_MODE=false
